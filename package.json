{
  "name": "@ironflowsh/mcp",
  "version": "0.8.2",
  "mcpName": "io.github.ironflowsh/mcp",
  "description": "Read-only Hyperliquid market data and wallet analytics MCP server for Claude, Cursor and AI agents",
  "author": "Ironflow <hello@ironflow.sh>",
  "homepage": "https://docs.ironflow.sh/guides/ai-agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/ironflowsh/mcp.git"
  },
  "bugs": {
    "email": "support@ironflow.sh",
    "url": "https://github.com/ironflowsh/mcp/issues"
  },
  "type": "module",
  "bin": {
    "ironflow-mcp": "./build/index.js",
    "ironflow-mcp-http": "./build/http.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js build/http.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "rm -rf build && npm run build",
    "start:http": "node build/http.js"
  },
  "files": [
    "build",
    "!build/**/*.test.js",
    "!build/**/*.test.d.ts",
    "!build/**/*.test.js.map",
    "!build/**/*.test.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ironflow",
    "market-data",
    "crypto",
    "crypto-mcp",
    "defi",
    "defi-mcp",
    "perpetuals",
    "hyperliquid",
    "hyperliquid-mcp",
    "trading-mcp",
    "claude-mcp",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
