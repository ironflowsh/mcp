{
  "name": "@ironflowsh/mcp",
  "version": "0.18.1",
  "mcpName": "io.github.ironflowsh/hyperliquid",
  "description": "Ironflow Hyperliquid MCP server: market data, liquidations, wallet analytics, alerts and Ironbox paper-trading sandboxes for AI agents and trading bots",
  "author": "Ironflow <hello@ironflow.sh>",
  "homepage": "https://docs.ironflow.sh/guides/ai-agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/ironflowsh/mcp.git"
  },
  "bugs": {
    "email": "support@ironflow.sh",
    "url": "https://github.com/ironflowsh/mcp/issues"
  },
  "type": "module",
  "bin": {
    "ironflow-mcp": "./build/index.js",
    "ironflow-mcp-http": "./build/http.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js build/http.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "rm -rf build && npm run build",
    "start:http": "node build/http.js",
    "bump": "node scripts/bump.mjs"
  },
  "files": [
    "build",
    "!build/**/*.test.js",
    "!build/**/*.test.d.ts",
    "!build/**/*.test.js.map",
    "!build/**/*.test.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ironflow",
    "ironbox",
    "hyperliquid",
    "hyperliquid-mcp",
    "hyperliquid-api",
    "hyperliquid-data",
    "hyperliquid-trading-bot",
    "liquidations",
    "market-data",
    "paper-trading",
    "trading-bot",
    "trading-agent",
    "trading-mcp",
    "x402",
    "perpetuals",
    "prediction-markets",
    "crypto",
    "crypto-mcp",
    "defi",
    "defi-mcp",
    "claude-mcp",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
